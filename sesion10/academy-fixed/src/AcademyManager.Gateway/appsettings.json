{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Yarp": "Warning"
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://+:8081" }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "students-route": {
        "ClusterId": "academy-api-cluster",
        "Match": {
          "Path": "/api/students/{**catch-all}"
        },
        "Transforms": [
          { "RequestHeader": "X-Gateway", "Set": "academy-gateway" },
          { "RequestHeadersCopy": "true" },
          { "RequestHeaderOriginalHost": "true" }
        ]
      },
      "subjects-route": {
        "ClusterId": "academy-api-cluster",
        "Match": {
          "Path": "/api/subjects/{**catch-all}"
        },
        "Transforms": [
          { "RequestHeader": "X-Gateway", "Set": "academy-gateway" }
        ]
      },
      "enrollments-route": {
        "ClusterId": "academy-api-cluster",
        "Match": {
          "Path": "/api/enrollments/{**catch-all}"
        },
        "Transforms": [
          { "RequestHeader": "X-Gateway", "Set": "academy-gateway" }
        ]
      }
    },
    "Clusters": {
      "academy-api-cluster": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/healthz/ready"
          }
        },
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "academy-api-1": {
            "Address": "http://academy-api:8080"
          }
        }
      }
    }
  }
}
